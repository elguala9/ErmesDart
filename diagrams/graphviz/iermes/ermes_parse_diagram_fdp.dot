  _MessageTypeService -> ServiceMessage [arrowhead=open, dir=forward, style=solid, label="uses"];
  _SignalData -> SignalData [arrowhead=open, dir=forward, style=solid, label="uses"];
  _SignalInfoAnswer -> SignalInfoAnswer [arrowhead=open, dir=forward, style=solid, label="uses"];
  _SignalInfoOffer -> SignalInfoOffer [arrowhead=open, dir=forward, style=solid, label="uses"];
}
