digraph UMLClassDiagram {
  graph [splines=spline, overlap=false, sep=0.5, repulsiveforce=2.0 fontname="Helvetica"];
  node  [shape=none, margin=0, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9];

  ErmesMessageControlFactory [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F2FD">
      <TR><TD ALIGN="CENTER" BGCOLOR="#1565C0"><FONT COLOR="white"><B>&lt;&lt;class&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>ErmesMessageControlFactory</B></TD></TR>
    </TABLE>
  >];
  MessageControlData [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F2FD">
      <TR><TD ALIGN="CENTER" BGCOLOR="#1565C0"><FONT COLOR="white"><B>&lt;&lt;class&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>MessageControlData</B></TD></TR>
    </TABLE>
  >];
  ErmesMessageControlRepository [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F2FD">
      <TR><TD ALIGN="CENTER" BGCOLOR="#1565C0"><FONT COLOR="white"><B>&lt;&lt;class&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>ErmesMessageControlRepository</B></TD></TR>
    </TABLE>
  >];
  ErmesMessageControlServiceOpts [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F2FD">
      <TR><TD ALIGN="CENTER" BGCOLOR="#1565C0"><FONT COLOR="white"><B>&lt;&lt;class&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>ErmesMessageControlServiceOpts</B></TD></TR>
    </TABLE>
  >];
  ErmesMessageControlService [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#E3F2FD">
      <TR><TD ALIGN="CENTER" BGCOLOR="#1565C0"><FONT COLOR="white"><B>&lt;&lt;class&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>ErmesMessageControlService</B></TD></TR>
    </TABLE>
  >];
  IErmesMessageControlRepository [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F5F5F5">
      <TR><TD ALIGN="CENTER" BGCOLOR="#616161"><FONT COLOR="white"><B>&lt;&lt;interface&gt;&gt;, &lt;&lt;external&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>IErmesMessageControlRepository</B></TD></TR>
    </TABLE>
  >];
  IdType [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F5F5F5">
      <TR><TD ALIGN="CENTER" BGCOLOR="#616161"><FONT COLOR="white"><B>&lt;&lt;interface&gt;&gt;, &lt;&lt;external&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>IdType</B></TD></TR>
    </TABLE>
  >];
  CallbackIdsToRequest [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F5F5F5">
      <TR><TD ALIGN="CENTER" BGCOLOR="#616161"><FONT COLOR="white"><B>&lt;&lt;interface&gt;&gt;, &lt;&lt;external&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>CallbackIdsToRequest</B></TD></TR>
    </TABLE>
  >];
  IErmesMessageControlService [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F5F5F5">
      <TR><TD ALIGN="CENTER" BGCOLOR="#616161"><FONT COLOR="white"><B>&lt;&lt;interface&gt;&gt;, &lt;&lt;external&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>IErmesMessageControlService</B></TD></TR>
    </TABLE>
  >];
  CallbackHandler [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#F5F5F5">
      <TR><TD ALIGN="CENTER" BGCOLOR="#616161"><FONT COLOR="white"><B>&lt;&lt;interface&gt;&gt;, &lt;&lt;external&gt;&gt;</B></FONT></TD></TR>
      <TR><TD ALIGN="CENTER"><B>CallbackHandler</B></TD></TR>
    </TABLE>
  >];

  ErmesMessageControlFactory -> ErmesMessageControlRepository [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlFactory -> ErmesMessageControlService [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlFactory -> IErmesMessageControlRepository [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlRepository -> CallbackIdsToRequest [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlRepository -> IdType [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlService -> CallbackHandler [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlService -> CallbackIdsToRequest [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlService -> ErmesMessageControlServiceOpts [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlService -> IErmesMessageControlRepository [arrowhead=open, dir=forward, style=solid, label="uses"];
  ErmesMessageControlService -> IdType [arrowhead=open, dir=forward, style=solid, label="uses"];
  IErmesMessageControlRepository -> ErmesMessageControlRepository [arrowhead=empty, dir=back, style=dashed, label="implements"];
  IErmesMessageControlService -> ErmesMessageControlService [arrowhead=empty, dir=back, style=dashed, label="implements"];
  MessageControlData -> IdType [arrowhead=open, dir=forward, style=solid, label="uses"];
}
